diff --git a/.github/workflows/pages.yml b/.github/workflows/pages.yml
index 6dc6997..a4f0f5c 100644
--- a/.github/workflows/pages.yml
+++ b/.github/workflows/pages.yml
@@ -5,6 +5,11 @@
 # pipes into their shell, so the deploy step only ever copies files that already passed
 # `scripts/installer/render.sh --check` and `scripts/install.test.sh` in CI.
 #
+# The site is only allowed to exist once a release does. `install.sh` pins no version: it resolves
+# `releases/latest` at run time, so serving it before the first release advertises a command that
+# 404s. The `gate` job below decides (`scripts/ci/pages-release-gate.mjs`, tested by
+# `scripts/ci/pages-release-gate.test.mjs`) and `build`/`deploy` are skipped when it refuses.
+#
 # Prerequisites that this workflow cannot create (see 05_release/output/release-runbook.md):
 #   - GitHub Pages enabled on the repository with source "GitHub Actions"
 #   - Pages on a PRIVATE repository needs GitHub Pro/Team/Enterprise; otherwise make the repo public
@@ -24,6 +29,12 @@ on:
   release:
     types: [published]
   workflow_dispatch:
+    inputs:
+      allow_without_release:
+        description: "Deploy even though no release is published yet (domain or certificate setup only; the served installer cannot install until a release exists)"
+        required: false
+        default: false
+        type: boolean
 
 permissions:
   contents: read
@@ -34,8 +45,39 @@ concurrency:
   cancel-in-progress: true
 
 jobs:
+  gate:
+    name: a published release must exist first
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    outputs:
+      serve: ${{ steps.gate.outputs.serve }}
+      reason: ${{ steps.gate.outputs.reason }}
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
+
+      - name: Does releases/latest resolve to anything the served installer could install?
+        id: gate
+        env:
+          GH_TOKEN: ${{ github.token }}
+          TRENT_PAGES_ALLOW_WITHOUT_RELEASE: ${{ inputs.allow_without_release }}
+        run: |
+          set -euo pipefail
+          gh api "repos/$GITHUB_REPOSITORY/releases?per_page=100" > "$RUNNER_TEMP/releases.json"
+          node scripts/ci/pages-release-gate.mjs "$RUNNER_TEMP/releases.json"
+
+      - name: Say why nothing was deployed
+        if: steps.gate.outputs.serve != 'true'
+        env:
+          REASON: ${{ steps.gate.outputs.reason }}
+        run: |
+          set -euo pipefail
+          echo "::notice::Pages deploy skipped: $REASON"
+          printf '### Pages deploy skipped\n\n%s\n' "$REASON" >> "$GITHUB_STEP_SUMMARY"
+
   build:
     name: assemble the site
+    needs: gate
+    if: needs.gate.outputs.serve == 'true'
     runs-on: ubuntu-latest
     timeout-minutes: 10
     steps:
@@ -80,7 +122,8 @@ jobs:
 
   deploy:
     name: deploy to GitHub Pages
-    needs: build
+    needs: [gate, build]
+    if: needs.gate.outputs.serve == 'true'
     runs-on: ubuntu-latest
     timeout-minutes: 10
     permissions:
