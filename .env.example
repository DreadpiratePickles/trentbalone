# ─────────────────────────────────────────────────────────────────────────────
# Trent AI Cofounder — Environment Variables (authoritative)
# Copy to .env.local and fill in values. Next.js loads .env.local automatically.
# NEVER commit .env.local or real secrets.
#
# Legend:
#   [required-local]  Needed for the documented happy path in docs/RUN.md
#   [optional]        App boots without it; feature degrades gracefully
#   [production]      Required only when NODE_ENV=production
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# [required-local] Postgres (see docs/RUN.md — Docker or Supabase).
# Prisma reads both URLs from prisma/schema.prisma.
#
# Local Docker (docker-compose.dev.yml):
#   DATABASE_URL="postgresql://trent:trentdev@localhost:5432/trent"
#   DIRECT_URL="postgresql://trent:trentdev@localhost:5432/trent"
#
# Supabase: use the transaction pooler (6543) for DATABASE_URL and direct (5432) for DIRECT_URL.
DATABASE_URL=""
DIRECT_URL=""

# [optional] Read replica URL for reporting queries (lib/db-read.ts).
READ_DATABASE_URL=""

# ── Auth (NextAuth v5) ───────────────────────────────────────────────────────
# [required-local] Session signing secret. Code reads AUTH_SECRET first, then NEXTAUTH_SECRET.
# Generate: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_RANDOM_SECRET"
# [optional] Legacy alias — only needed if you already use NEXTAUTH_SECRET elsewhere.
NEXTAUTH_SECRET=""

# [optional] NextAuth Google sign-in (lib/auth.ts reads AUTH_GOOGLE_*).
# Same app credentials can be reused as GOOGLE_CLIENT_* below for platform OAuth.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# [optional] Show the Google button on /auth/signin (app/auth/signin/page.tsx).
NEXT_PUBLIC_HAS_GOOGLE=""

# ── AI / LLM ──────────────────────────────────────────────────────────────────
# [required-local] OpenAI API key — lib/ai-client.ts throws without it on LLM calls.
OPENAI_API_KEY=""
# [optional] OpenAI-compatible proxy (the AI platform bridge, Azure OpenAI, etc.).
OPENAI_BASE_URL=""

# Model overrides (lib/ai-client.ts MODELS registry). Defaults shown in comments.
# All defaults are real OpenAI API model IDs; override if your account lacks access.
# OPENAI_MODEL_FAST    default gpt-4.1-nano   — triage, cheap tasks
OPENAI_MODEL_FAST=""
# OPENAI_MODEL_DEFAULT default gpt-4.1-mini   — agents, CEO chat (also OPENAI_MODEL alias)
OPENAI_MODEL_DEFAULT=""
OPENAI_MODEL=""
# OPENAI_MODEL_STRONG  default gpt-5.2        — orchestration planning, critique
OPENAI_MODEL_STRONG=""
# OPENAI_MODEL_CODING  default gpt-5.2-codex  — workbench build loop (WORKBENCH_PLANNER_MODEL alias)
OPENAI_MODEL_CODING=""
WORKBENCH_PLANNER_MODEL=""
# OPENAI_MODEL_CRITIC  default gpt-5.2        — verification / safety review
OPENAI_MODEL_CRITIC=""

# [optional] Per-role orchestrator overrides (lib/orchestrator-runtime.ts, lib/orchestrator.ts).
PLANNER_MODEL=""
SPECIALIST_MODEL=""
CRITIC_MODEL=""

# [optional] Wiki semantic search answer model (app/api/companies/[id]/wiki/semantic/route.ts).
# EMBEDDING_MODEL default text-embedding-3-small (lib/wiki-embeddings.ts).
EMBEDDING_MODEL=""
# FOUNDRY_MODEL default claude-sonnet-4-5 via OPENAI_MODEL (lib/skill-foundry.ts).
FOUNDRY_MODEL=""
GEPA_MODEL=""

# ── Redis / job queue ─────────────────────────────────────────────────────────
# [required-local] BullMQ worker + durable queue (lib/worker.ts, lib/queue.ts).
# Local Docker: redis://localhost:6379
REDIS_URL=""
# [optional] Upstash REST fallback for rate limiting (lib/redis.ts).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# [optional] Disable in-process queue fallback in tests/evals (lib/queue.ts).
TRENT_QUEUE_FALLBACK=""
TRENT_JOB_TIMEOUT_MS=""

# ── Encryption ────────────────────────────────────────────────────────────────
# [optional] Dev falls back to a local default (lib/secrets.ts).
# [production] Required in production. Generate: openssl rand -hex 32
SECRET_ENCRYPTION_KEY=""

# ── App URLs ──────────────────────────────────────────────────────────────────
# [optional] Public app URL and subdomain routing (next.config.ts uses BASE_DOMAIN).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_DOMAIN="trent.app"
BASE_DOMAIN="trent.app"

# ── Workbench ─────────────────────────────────────────────────────────────────
# [optional] Default sandbox: mock_local in dev when no cloud keys (lib/workbench-providers.ts).
WORKBENCH_DEFAULT_PROVIDER=""
E2B_API_KEY=""
E2B_TEMPLATE="base"
E2B_SANDBOX_TIMEOUT_MS=""
E2B_EXEC_TIMEOUT_MS=""
DAYTONA_API_KEY=""
DAYTONA_API_URL=""
DAYTONA_TARGET=""
WORKBENCH_STORAGE_ROOT=""
WORKBENCH_BUILD_MAX_ATTEMPTS="5"
WORKBENCH_IDLE_TIMEOUT_SECONDS="600"
WORKBENCH_CRITIC_ENABLED=""
STEEL_ALLOW_LOCAL_URLS=""

# ── GitHub (integrations + seed) ──────────────────────────────────────────────
GITHUB_TOKEN=""
GITHUB_OWNER=""
GITHUB_REPO=""

# ── Google platform OAuth (YouTube, operator tools — NOT NextAuth sign-in) ───
# lib/google/google-oauth.ts, lib/platform-oauth.ts
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI=""
GOOGLE_REFRESH_TOKEN=""

# ── Platform OAuth (social / ads — lib/platform-oauth.ts) ─────────────────────
META_CLIENT_ID=""
META_CLIENT_SECRET=""
META_GRAPH_VERSION="v20.0"
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_API_BASE_URL=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# ── Platform action modes ─────────────────────────────────────────────────────
# [optional] Set to "live" for real external API calls; otherwise sandbox adapters.
PLATFORM_ACTION_MODE=""
SOCIAL_INBOX_INGESTION_MODE=""

# ── Cron / scheduler ──────────────────────────────────────────────────────────
# [optional] Bearer token for /api/jobs/scheduler and /api/heartbeat/sweep.
CRON_SECRET=""

# ── Operator access ───────────────────────────────────────────────────────────
# [optional] Comma-separated emails allowed for operator routes (lib/google/operator-auth.ts).
OPERATOR_EMAILS=""

# ── Stripe (marketing) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── Email ─────────────────────────────────────────────────────────────────────
# Credential registry uses POSTMARK_API_KEY (lib/credential-boundary.ts).
POSTMARK_API_KEY=""
POSTMARK_SERVER_TOKEN=""
POSTMARK_FROM_EMAIL="trent@yourdomain.com"

# ── Content / generation providers ────────────────────────────────────────────
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""
TOGETHER_API_KEY=""
ELEVENLABS_API_KEY=""
SUNO_API_KEY=""
UDIO_API_KEY=""
KLING_API_KEY=""
LUMAAI_API_KEY=""
RUNWAYML_API_SECRET=""
PIKA_API_KEY=""
TAVILY_API_KEY=""
TREND_RESEARCH_MODE=""
HIGGSFIELD_API_KEY=""
HIGGSFIELD_API_BASE_URL=""
HIGGSFIELD_GENERATION_MODE=""

# ── Provisioning (Phase 3 — optional for local dev) ───────────────────────────
GITHUB_PLATFORM_ORG="trent-platform"
GITHUB_APP_ID=""
GITHUB_APP_INSTALLATION_ID=""
GITHUB_APP_PRIVATE_KEY=""
NEON_API_KEY=""
VERCEL_TOKEN=""
VERCEL_TEAM_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_ACCOUNT_ID=""
TRENT_PLATFORM_DOMAIN="trent.app"
TRENT_WEBHOOK_BASE_URL=""
RENDER_API_KEY=""
RENDER_OWNER_ID=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG="trent-platform"
SENTRY_TEAM="engineering"
EXPO_TOKEN=""
EXPO_ORG="trent-platform"

# ── Backup health (/api/health) ───────────────────────────────────────────────
# [optional] When unset, backup probe fails and /api/health returns 503 degraded.
BACKUP_DIR=""
BACKUP_MAX_AGE_HOURS="25"

# ── Misc integrations ─────────────────────────────────────────────────────────
GITNEXUS_VAULT_ENABLED=""
GBRAIN_URL=""
GBRAIN_API_KEY=""
WIKI_EMBED_STORE=""
CAMOFOX_BASE_URL="http://localhost:9377"
CAMOFOX_ACCESS_KEY=""
CAMOFOX_USER_ID="trent"
HYPERFRAMES_EXECUTION=""
HYPERFRAMES_WORKSPACE_ROOT=""
CLAUDE_ADS_MODE="critic"
FINCEPT_SANDBOX_MODE="planned"
OPEN_GENERATIVE_AI_SANDBOX_MODE="planned"
LOG_LEVEL=""
