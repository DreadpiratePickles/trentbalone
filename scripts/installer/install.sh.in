#!/bin/sh
# Trent Fleet installer (POSIX sh). GENERATED from scripts/installer/install.sh.in by
# scripts/installer/render.sh — edit the template, the stage manifest or the keys, never this file.
#
#   curl -fsSL https://agent.let-trent.uk/install.sh | bash
#
# That one line is the whole install: it downloads the compiled `trent` binary for this OS and
# CPU from GitHub Releases, refuses it unless the release's SHA256SUMS carries a valid signature
# from the Trent release key embedded below AND the binary's SHA-256 matches, installs it under
# ~/.trent, appends one PATH line to your shell rc (only if absent; printed so you can do it
# yourself), then runs `trent setup` and `trent doctor` from the installed binary.
# No sudo. Nothing is written outside $HOME.
#
#   install.sh [--json] [--stage <name>] [--version <x.y.z>] [--force] [--non-interactive]
#              [--allow-root] [--insecure-base-url <url>]
#   install.sh --manifest          # {"protocol_version":1,"stages":[...]}
#
# Protocol: with --json, stdout carries exactly one frame per stage —
#   {"ok":bool,"stage":str,"skipped":bool,"reason"?:str,"duration_ms":int}
# and human text goes to stderr. Every stage body runs in a subshell, so a helper that calls
# `exit 1` ends the stage, not the installer: a missing frame is structurally impossible.
# Stages are idempotent and individually re-runnable with --stage; there is no rollback and
# nothing is ever deleted — a bad install directory is moved to <dir>.broken-<utc-timestamp>.
#
# Security properties (see scripts/installer/THREAT-MODEL.md):
#   HTTPS only (--proto '=https' --tlsv1.2); redirects that leave the release hosts are refused;
#   SHA256SUMS must verify against the embedded release public key; every artefact's SHA-256 and
#   byte length must match; the version string must match a strict pattern before it touches a
#   URL or a path; download and verification happen in a private (0700) directory and the
#   verified file is renamed into place; no eval, no nested curl|sh, no root without --allow-root.
#
# Env:
#   TRENT_HOME                install root (default ~/.trent; must be under $HOME)
#   TRENT_VERSION             version to install (default: latest release)
#   TRENT_NO_MODIFY_PATH=1    do not touch the shell rc (the PATH line is still printed)
#   NO_COLOR                  disable colour
set -eu
IFS=" 	
"   # space, tab, newline: the default field separator, explicitly
umask 077
(set -o pipefail) 2>/dev/null && set -o pipefail   # not in every /bin/sh; on where available

TRENT_REPO="DreadpiratePickles/trentbalone"
RELEASE_BASE="https://github.com/$TRENT_REPO/releases/download"
RELEASE_LATEST="https://github.com/$TRENT_REPO/releases/latest"
ALLOWED_HOSTS="github.com objects.githubusercontent.com release-assets.githubusercontent.com"
CURL_PROTO="=https"
INSECURE_BASE=0

TRENT_HOME="${TRENT_HOME:-$HOME/.trent}"
BIN_DIR="$TRENT_HOME/bin"
VERSIONS_DIR="$TRENT_HOME/versions"
STAGING_DIR="$TRENT_HOME/staging"
STATE_FILE="$TRENT_HOME/installer/state"
CURRENT_FILE="$TRENT_HOME/current"

JSON=0
FORCE=0
NONINTERACTIVE=0
ALLOW_ROOT=0
ONLY_STAGE=""
REQUESTED_VERSION="${TRENT_VERSION:-}"
RUN_TMP=""
FAILED_STAGE=""
VERSION_RE='^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$'

@@STAGES@@

# ------------------------------------------------------------------- release public keys
# Canonical: Ed25519 in minisign format (shared with `trent update` and `trent desktop install`).
# Verified with minisign, or with OpenSSL >= 1.1.1 via the equivalent SPKI form below.
MINISIGN_PUB='@@MINISIGN_PUB@@'
ED25519_PEM="$(cat <<'PEM'
@@ED25519_PEM@@
PEM
)"
# Co-signature for hosts whose only openssl is LibreSSL 3.3 (stock macOS): it has no Ed25519 and
# no BLAKE2b, but verifies ECDSA P-256. The release job signs SHA256SUMS with both keys.
ECDSA_PEM="$(cat <<'PEM'
@@ECDSA_PEM@@
PEM
)"

# ------------------------------------------------------------------------------- banner
# Pre-rendered by scripts/installer/banner*.ansi from the CLI's own theme; embedded at render
# time so the single downloaded script carries it. Empty when the files were absent at render.
BANNER_TRUECOLOR="$(cat <<'__TRENT_BANNER__'
@@BANNER_TRUECOLOR@@
__TRENT_BANNER__
)"
BANNER_16="$(cat <<'__TRENT_BANNER__'
@@BANNER_16@@
__TRENT_BANNER__
)"

# ------------------------------------------------------------------------------ output
# Palette: bone #F1ECE2 (text), mist #94A3B8 (secondary), pulse #6EE7B7 (success). Nothing else.
C_BONE=""; C_MIST=""; C_PULSE=""; C_OFF=""
COLOUR_MODE=none
detect_colour() {
  fd=1; [ "$JSON" = 1 ] && fd=2
  if [ -n "${NO_COLOR:-}" ] || ! [ -t "$fd" ]; then COLOUR_MODE=none; return 0; fi
  case "${COLORTERM:-}" in truecolor|24bit) COLOUR_MODE=truecolor ;; *)
    case "${TERM:-}" in *-256color) COLOUR_MODE=256 ;; ""|dumb) COLOUR_MODE=none ;; *) COLOUR_MODE=16 ;; esac ;;
  esac
  [ "$COLOUR_MODE" = none ] && return 0
  if [ "$COLOUR_MODE" = truecolor ]; then
    C_BONE="$(printf '\033[38;2;241;236;226m')"; C_MIST="$(printf '\033[38;2;148;163;184m')"; C_PULSE="$(printf '\033[38;2;110;231;183m')"
  else
    C_BONE="$(printf '\033[97m')"; C_MIST="$(printf '\033[37m')"; C_PULSE="$(printf '\033[92m')"
  fi
  C_OFF="$(printf '\033[0m')"
}
# Human text: stdout normally, stderr when stdout is the JSON frame channel.
say() { if [ "$JSON" = 1 ]; then printf '%s\n' "$*" >&2; else printf '%s\n' "$*"; fi; }
print_banner() {
  say ""
  banner=""
  case "$COLOUR_MODE" in
    truecolor) banner="$BANNER_TRUECOLOR" ;;
    256|16)    banner="$BANNER_16" ;;
  esac
  if [ -n "$banner" ]; then say "$banner"; else say "${C_BONE}  TRENT FLEET${C_OFF}  ${C_MIST}the cofounder who never sleeps${C_OFF}"; fi
  say "${C_MIST}  installing under $TRENT_HOME${C_OFF}"
  say ""
}

json_escape() { # stdin -> escaped string (no surrounding quotes)
  awk 'BEGIN { ORS = "" } { gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/\t/, "\\t"); gsub(/\r/, ""); if (NR > 1) printf "\\n"; printf "%s", $0 }'
}
now_ms() {
  t=$(date +%s%N 2>/dev/null)
  case "$t" in
    ""|*[!0-9]*) echo $(( $(date +%s) * 1000 )) ;;
    *) echo $(( t / 1000000 )) ;;
  esac
}
utc_stamp() { date -u +%Y%m%dT%H%M%SZ; }

emit_frame() { # $1 ok(true|false) $2 stage $3 skipped(true|false) $4 reason $5 duration_ms
  if [ "$JSON" = 1 ]; then
    printf '{"ok":%s,"stage":"%s","skipped":%s' "$1" "$2" "$3"
    [ -n "$4" ] && printf ',"reason":"%s"' "$(printf '%s' "$4" | json_escape)"
    printf ',"duration_ms":%s}\n' "$5"
  else
    title=$(stage_title "$2")
    if [ "$1" = true ] && [ "$3" = false ] && [ -z "$4" ]; then
      say "  ${C_PULSE}ok  ${C_OFF} ${C_BONE}$title${C_OFF} ${C_MIST}${5}ms${C_OFF}"
    elif [ "$1" = true ] && [ "$3" = false ]; then
      say "  ${C_PULSE}ok  ${C_OFF} ${C_BONE}$title${C_OFF} ${C_MIST}$4${C_OFF}"
    elif [ "$1" = true ]; then
      say "  ${C_MIST}skip${C_OFF} ${C_BONE}$title${C_OFF} ${C_MIST}$4${C_OFF}"
    else
      say "  ${C_BONE}FAIL${C_OFF} ${C_BONE}$title${C_OFF}"
      printf '%s\n' "$4" | while IFS= read -r line; do say "       ${C_MIST}$line${C_OFF}"; done
    fi
  fi
}

# --------------------------------------------------------------------------- stage runner
# Outcome channel from the stage subshell to the runner: an exit code plus a reason file.
#   exit 0  ok            exit 75 skipped (reason)     exit 76 ok with a note (reason)
#   any other exit code   failed (reason if the stage wrote one, else a generic message)
skip() { printf '%s' "$1" > "$RUN_TMP/reason"; exit 75; }
soft() { printf '%s' "$1" > "$RUN_TMP/reason"; exit 76; }
fail() { printf '%s' "$1" > "$RUN_TMP/reason"; exit 1; }

is_root() { [ "$(id -u 2>/dev/null || echo 1)" = 0 ]; }

init_run() {
  [ -n "$RUN_TMP" ] && return 0
  case "$TRENT_HOME" in
    "$HOME"|"$HOME"/*) ;;
    *) echo "TRENT_HOME=$TRENT_HOME is outside HOME=$HOME; the installer never writes outside your home" >&2; exit 2 ;;
  esac
  mkdir -p "$TRENT_HOME" "$BIN_DIR" "$VERSIONS_DIR" "$STAGING_DIR" "$TRENT_HOME/installer"
  # Private scratch space on the same filesystem as the install, so a verified file can be
  # renamed into place atomically. umask 077 makes it 0700.
  RUN_TMP=$(mktemp -d "$STAGING_DIR/run.XXXXXX")
  trap 'rm -rf "$RUN_TMP"' EXIT
}

run_stage() {
  init_run
  name=$1
  fn="stage_$(printf '%s' "$name" | tr '-' '_')"
  start=$(now_ms)
  : > "$RUN_TMP/reason"
  if [ -n "$FAILED_STAGE" ]; then
    emit_frame true "$name" true "not run: stage $FAILED_STAGE failed" 0
    return 0
  fi
  if is_root && [ "$ALLOW_ROOT" = 0 ]; then
    emit_frame false "$name" false "refusing to run as root: trent installs under \$HOME without sudo. Re-run as your own user, or pass --allow-root if this really is intended" 0
    FAILED_STAGE="$name"
    return 0
  fi
  if [ "$NONINTERACTIVE" = 1 ] && stage_needs_input "$name"; then
    reason=$("$fn" --describe-input 2>/dev/null || echo "needs user input; non-interactive run")
    emit_frame true "$name" true "$reason" 0
    return 0
  fi
  # The subshell is the guarantee: `exit` inside the stage or any helper it calls ends the
  # subshell only. Control always comes back here, and a frame is always written.
  if ( "$fn" ); then rc=0; else rc=$?; fi
  reason=$(cat "$RUN_TMP/reason")
  dur=$(( $(now_ms) - start ))
  case "$rc" in
    0)  emit_frame true "$name" false "" "$dur" ;;
    75) emit_frame true "$name" true "$reason" "$dur" ;;
    76) emit_frame true "$name" false "$reason" "$dur" ;;
    *)  [ -n "$reason" ] || reason="stage $name exited with status $rc"
        emit_frame false "$name" false "$reason" "$dur"
        FAILED_STAGE="$name" ;;
  esac
  return 0
}

# ------------------------------------------------------------------------------- state
# Stages hand facts to each other through a plain key=value file, so --stage <name> can resume
# after a failure without repeating earlier stages. Read with sed, never sourced or eval'd.
state_get() { if [ -f "$STATE_FILE" ]; then sed -n "s/^$1=//p" "$STATE_FILE" | head -n 1; fi; }
state_set() {
  tmp="$STATE_FILE.tmp.$$"
  { if [ -f "$STATE_FILE" ]; then sed "/^$1=/d" "$STATE_FILE"; fi; printf '%s=%s\n' "$1" "$2"; } | LC_ALL=C sort > "$tmp"
  mv "$tmp" "$STATE_FILE"
}
need_state() { v=$(state_get "$1"); [ -n "$v" ] || fail "no $1 recorded; run the $2 stage first (install.sh --stage $2)"; printf '%s' "$v"; }
valid_version() { printf '%s' "$1" | grep -Eq "$VERSION_RE"; }
need_version() { v=$(need_state VERSION resolve-version); valid_version "$v" || fail "recorded version '$v' is not a valid version string"; printf '%s' "$v"; }
installed_version() { # the version the launcher points at, or empty
  if [ -f "$CURRENT_FILE" ]; then v=$(head -n 1 "$CURRENT_FILE"); if valid_version "$v"; then printf '%s' "$v"; fi; fi
}
need_sha() { v=$(need_state EXPECTED_SHA resolve-version); printf '%s' "$v" | grep -Eq '^[0-9a-f]{64}$' || fail "recorded digest is malformed"; printf '%s' "$v"; }

digest() { # sha256 of file $1, lowercase hex
  case "$(state_get SHATOOL)" in
    sha256sum) sha256sum "$1" | cut -c1-64 ;;
    shasum)    shasum -a 256 "$1" | cut -c1-64 ;;
    openssl)   openssl dgst -sha256 "$1" | sed 's/.*= //' ;;
    *)         fail "no SHA-256 tool recorded; run the detect stage" ;;
  esac
}

# 0 if $1 < $2 (dotted numeric versions; anything after a '-' is ignored)
version_lt() {
  awk -v a="${1%%-*}" -v b="${2%%-*}" 'BEGIN {
    n = split(a, x, "."); m = split(b, y, "."); k = (n > m ? n : m)
    for (i = 1; i <= k; i++) { p = (i <= n ? x[i] : 0) + 0; q = (i <= m ? y[i] : 0) + 0
      if (p < q) exit 0; if (p > q) exit 1 }
    exit 1 }'
}

interactive() {
  [ "$NONINTERACTIVE" = 0 ] || return 1
  [ -z "${CI:-}" ] || return 1
  if [ -t 0 ]; then return 0; fi
  # `curl | sh` leaves stdin holding the script; the terminal is still reachable via /dev/tty.
  [ -t 2 ] && ( : < /dev/tty ) 2>/dev/null
}

url_host() { # scheme://host[:port]/... -> host[:port]
  printf '%s' "$1" | sed -E 's#^[a-z]+://([^/@]*@)?([^/]+).*#\2#'
}
host_allowed() {
  h=$1
  for a in $ALLOWED_HOSTS; do [ "$h" = "$a" ] && return 0; done
  return 1
}

# fetch URL OUT: TLS 1.2+, HTTPS only unless --insecure-base-url, at most 5 redirects; then the
# effective URL's host must be a release host and the byte count must match Content-Length.
fetch() {
  url=$1; out=$2
  case "$url" in https://*) ;; http://*) [ "$INSECURE_BASE" = 1 ] || fail "refusing plain http URL $url" ;; *) fail "refusing non-http(s) URL $url" ;; esac
  rm -f "$out" "$out.headers"
  if ! info=$(curl --proto "$CURL_PROTO" --tlsv1.2 -fsSL --max-redirs 5 --connect-timeout 15 --retry 3 --retry-delay 1 \
        -o "$out" -D "$out.headers" -w '%{size_download} %{url_effective}' "$url" 2> "$RUN_TMP/curl.err"); then
    err=$(cat "$RUN_TMP/curl.err"); rm -f "$out" "$out.headers"
    fail "download failed: $url
$err"
  fi
  size=${info%% *}; effective=${info#* }
  ehost=$(url_host "$effective")
  if ! host_allowed "$ehost"; then
    rm -f "$out" "$out.headers"
    fail "refused: $url redirected to $effective, whose host '$ehost' is not a release host ($ALLOWED_HOSTS)"
  fi
  # Content-Length of the final response (last header block); compare with what arrived.
  declared=$(awk '/^HTTP\// { cl = "" } tolower($1) == "content-length:" { cl = $2 } END { gsub(/\r/, "", cl); print cl }' "$out.headers")
  rm -f "$out.headers"
  if [ -n "$declared" ] && [ "$declared" != "$size" ]; then
    rm -f "$out"
    fail "truncated download: $url declared $declared bytes, received $size"
  fi
  [ -s "$out" ] || { rm -f "$out"; fail "download of $url produced an empty file"; }
}

# --------------------------------------------------------------------- signature checks
# Returns 0 when SHA256SUMS ($1) is signed by the release key; writes the method used to $3.
# Never returns "ok" without a cryptographic verification actually having run.
verify_sums_signature() {
  sums=$1; sigdir=$2; methodfile=$3
  minisig="$sigdir/SHA256SUMS.minisig"; ecsig="$sigdir/SHA256SUMS.sig"
  if [ -f "$minisig" ] && command -v minisign >/dev/null 2>&1; then
    if minisign -Vm "$sums" -x "$minisig" -P "$MINISIGN_PUB" > "$RUN_TMP/minisign.out" 2>&1; then
      echo "minisign (Ed25519)" > "$methodfile"; return 0
    fi
    fail "SHA256SUMS.minisig does NOT verify against the embedded Trent release key (minisign):
$(cat "$RUN_TMP/minisign.out")
The checksum file is not from the Trent release key. Nothing was installed."
  fi
  if [ -f "$minisig" ] && openssl_has_ed25519; then
    printf '%s\n' "$ED25519_PEM" > "$RUN_TMP/ed25519.pem"
    sed -n 2p "$minisig" | openssl base64 -d > "$RUN_TMP/minisig.bin" 2>/dev/null
    [ "$(wc -c < "$RUN_TMP/minisig.bin" | tr -d ' ')" = 74 ] || fail "SHA256SUMS.minisig is malformed (expected 74 signature bytes)"
    [ "$(dd if="$RUN_TMP/minisig.bin" bs=1 count=2 2>/dev/null)" = "ED" ] || fail "SHA256SUMS.minisig is not a prehashed (ED) minisign signature"
    sig_keyid=$(dd if="$RUN_TMP/minisig.bin" bs=1 skip=2 count=8 2>/dev/null | od -An -tx1 | tr -d ' \n')
    printf '%s\n' "$MINISIGN_PUB" | openssl base64 -d > "$RUN_TMP/pub.bin"
    pub_keyid=$(dd if="$RUN_TMP/pub.bin" bs=1 skip=2 count=8 2>/dev/null | od -An -tx1 | tr -d ' \n')
    [ "$sig_keyid" = "$pub_keyid" ] || fail "SHA256SUMS.minisig was made with key id $sig_keyid, but the Trent release key is $pub_keyid. Nothing was installed."
    dd if="$RUN_TMP/minisig.bin" bs=1 skip=10 count=64 2>/dev/null > "$RUN_TMP/sig.raw"
    openssl dgst -blake2b512 -binary "$sums" > "$RUN_TMP/prehash.bin"
    if openssl pkeyutl -verify -pubin -inkey "$RUN_TMP/ed25519.pem" -rawin -in "$RUN_TMP/prehash.bin" -sigfile "$RUN_TMP/sig.raw" > "$RUN_TMP/verify.out" 2>&1; then
      echo "openssl (Ed25519, minisign format)" > "$methodfile"; return 0
    fi
    fail "SHA256SUMS.minisig does NOT verify against the embedded Trent release key (openssl Ed25519):
$(cat "$RUN_TMP/verify.out")
The checksum file is not from the Trent release key. Nothing was installed."
  fi
  if [ -f "$ecsig" ]; then
    printf '%s\n' "$ECDSA_PEM" > "$RUN_TMP/ecdsa.pem"
    if openssl dgst -sha256 -verify "$RUN_TMP/ecdsa.pem" -signature "$ecsig" "$sums" > "$RUN_TMP/verify.out" 2>&1; then
      echo "openssl (ECDSA P-256 co-signature)" > "$methodfile"; return 0
    fi
    fail "SHA256SUMS.sig does NOT verify against the embedded Trent release key (ECDSA P-256):
$(cat "$RUN_TMP/verify.out")
The checksum file is not from the Trent release key. Nothing was installed."
  fi
  fail "no verifiable signature: need minisign, or OpenSSL >= 1.1.1 for SHA256SUMS.minisig, or SHA256SUMS.sig for LibreSSL. Refusing to install unsigned artefacts."
}
openssl_has_ed25519() {
  printf '%s\n' "$ED25519_PEM" > "$RUN_TMP/ed25519.probe.pem"
  openssl pkey -pubin -in "$RUN_TMP/ed25519.probe.pem" -noout >/dev/null 2>&1 && openssl dgst -blake2b512 /dev/null >/dev/null 2>&1
}

# ------------------------------------------------------------------------------ stages
detect_platform() {
  os=$(uname -s); arch=$(uname -m)
  case "$os" in
    Darwin) OS=darwin ;;
    Linux)  OS=linux ;;
    MINGW*|MSYS*|CYGWIN*) fail "this is a Windows shell; use install.ps1: irm https://agent.let-trent.uk/install.ps1 | iex" ;;
    *) fail "unsupported operating system: $os (supported: macOS, Linux; Windows via install.ps1)" ;;
  esac
  case "$arch" in
    arm64|aarch64) ARCH=arm64 ;;
    x86_64|amd64)  ARCH=x64 ;;
    *) fail "unsupported CPU architecture: $arch (supported: arm64, x86_64)" ;;
  esac
  [ "$OS-$ARCH" = "linux-arm64" ] && fail "no linux-arm64 build is published yet (supported: darwin-arm64, darwin-x64, linux-x64)"
  ASSET="trent-$OS-$ARCH"
}

stage_detect() {
  print_banner
  detect_platform
  command -v curl >/dev/null 2>&1 || fail "curl is required and was not found on PATH"
  command -v openssl >/dev/null 2>&1 || command -v minisign >/dev/null 2>&1 \
    || fail "openssl (or minisign) is required to verify the release signature; refusing to install unverified"
  if command -v sha256sum >/dev/null 2>&1; then SHATOOL=sha256sum
  elif command -v shasum >/dev/null 2>&1; then SHATOOL=shasum
  elif command -v openssl >/dev/null 2>&1; then SHATOOL=openssl
  else fail "no SHA-256 tool found (need sha256sum, shasum or openssl); refusing to install unverified"
  fi
  state_set OS "$OS"; state_set ARCH "$ARCH"; state_set ASSET "$ASSET"; state_set SHATOOL "$SHATOOL"
  say "       ${C_MIST}$OS/$ARCH, asset $ASSET, sha256 via $SHATOOL, colour $COLOUR_MODE${C_OFF}"
}

stage_resolve_version() {
  asset=$(need_state ASSET detect)
  if [ -n "$REQUESTED_VERSION" ]; then
    version="${REQUESTED_VERSION#v}"
  else
    location=$(curl --proto "$CURL_PROTO" --tlsv1.2 -fsSI --connect-timeout 15 -o /dev/null -w '%{redirect_url}' "$RELEASE_LATEST" 2> "$RUN_TMP/curl.err") \
      || fail "could not resolve the latest release from $RELEASE_LATEST: $(cat "$RUN_TMP/curl.err")"
    lhost=$(url_host "$location")
    host_allowed "$lhost" || fail "refused: $RELEASE_LATEST redirected to '$location', whose host is not a release host"
    case "$location" in
      */releases/tag/v*) version="${location##*/releases/tag/v}" ;;
      *) fail "unexpected redirect from $RELEASE_LATEST: '$location' (expected .../releases/tag/v<version>)" ;;
    esac
  fi
  # Strict shape before the version is used in any URL or path: no '/', '..', spaces or shell
  # metacharacters can get through, whatever the redirect or the caller supplied.
  valid_version "$version" || fail "refused: version '$version' does not match $VERSION_RE"
  state_set VERSION "$version"
  installed=$(installed_version)
  if [ -n "$installed" ] && [ "$FORCE" = 0 ] && version_lt "$version" "$installed"; then
    state_set ACTION keep-newer
    soft "installed $installed is newer than requested $version; keeping it (pass --force to downgrade)"
  fi
  state_set ACTION install
  base="$RELEASE_BASE/v$version"
  fetch "$base/SHA256SUMS" "$RUN_TMP/SHA256SUMS"
  # Signature files: fetch whichever exist; verify_sums_signature decides what it can check.
  # fail() exits the calling shell, so each optional fetch gets its own subshell.
  if ! ( fetch "$base/SHA256SUMS.minisig" "$RUN_TMP/SHA256SUMS.minisig" ); then rm -f "$RUN_TMP/SHA256SUMS.minisig"; : > "$RUN_TMP/reason"; fi
  if ! ( fetch "$base/SHA256SUMS.sig" "$RUN_TMP/SHA256SUMS.sig" ); then rm -f "$RUN_TMP/SHA256SUMS.sig"; : > "$RUN_TMP/reason"; fi
  [ -f "$RUN_TMP/SHA256SUMS.minisig" ] || [ -f "$RUN_TMP/SHA256SUMS.sig" ] \
    || fail "release v$version publishes no signature for SHA256SUMS (neither SHA256SUMS.minisig nor SHA256SUMS.sig); refusing unsigned artefacts"
  verify_sums_signature "$RUN_TMP/SHA256SUMS" "$RUN_TMP" "$RUN_TMP/method"
  expected=$(grep -E "^[0-9a-f]{64} [ *]$asset\$" "$RUN_TMP/SHA256SUMS" | head -n 1 | cut -c1-64)
  [ -n "$expected" ] || fail "release v$version has no SHA256SUMS entry for $asset"
  state_set EXPECTED_SHA "$expected"
  say "       ${C_MIST}trent $version; SHA256SUMS signature verified via $(cat "$RUN_TMP/method"); expected sha256 $expected${C_OFF}"
}

stage_download() {
  asset=$(need_state ASSET detect); version=$(need_version); expected=$(need_sha)
  [ "$(state_get ACTION)" = keep-newer ] && skip "installed $(installed_version) is newer than $version; pass --force to downgrade"
  target="$VERSIONS_DIR/$version/trent"
  if [ -f "$target" ] && [ "$(digest "$target")" = "$expected" ]; then
    skip "trent $version is already installed with a matching digest"
  fi
  url="$RELEASE_BASE/v$version/$asset"
  rm -f "$STAGING_DIR/$asset.unverified" "$STAGING_DIR/$asset.verified"
  # Into the private run directory; only the verify stage may promote it out of there.
  fetch "$url" "$RUN_TMP/$asset"
  mv "$RUN_TMP/$asset" "$STAGING_DIR/$asset.unverified"
  say "       ${C_MIST}$(wc -c < "$STAGING_DIR/$asset.unverified" | tr -d ' ') bytes from $url${C_OFF}"
}

stage_verify() {
  asset=$(need_state ASSET detect); version=$(need_version); expected=$(need_sha)
  [ "$(state_get ACTION)" = keep-newer ] && skip "nothing downloaded; installed version kept"
  staged="$STAGING_DIR/$asset.unverified"
  installed="$VERSIONS_DIR/$version/trent"
  if [ -f "$staged" ]; then
    actual=$(digest "$staged")
    if [ "$actual" != "$expected" ]; then
      rm -f "$staged"
      fail "SHA-256 mismatch for $asset (v$version); the download was discarded and nothing was installed
  expected $expected
  actual   $actual
The artefact does not match the signed SHA256SUMS. Retry later; if it persists, the release or the network path is compromised."
    fi
    # Same directory, same filesystem: the rename is atomic and the bytes verified are the bytes installed.
    mv "$staged" "$STAGING_DIR/$asset.verified"
    say "       ${C_MIST}sha256 $actual matches the signed SHA256SUMS${C_OFF}"
  elif [ -f "$STAGING_DIR/$asset.verified" ]; then
    [ "$(digest "$STAGING_DIR/$asset.verified")" = "$expected" ] || { rm -f "$STAGING_DIR/$asset.verified"; fail "previously verified file no longer matches; re-run the download stage"; }
    soft "re-verified the staged $asset"
  elif [ -f "$installed" ]; then
    actual=$(digest "$installed")
    [ "$actual" = "$expected" ] || fail "installed $installed has sha256 $actual, expected $expected; re-run without --stage to reinstall"
    soft "installed trent $version re-verified against the signed SHA256SUMS"
  else
    fail "nothing to verify: no download in $STAGING_DIR and no installed trent $version"
  fi
}

write_if_changed() { # $1 path, content on stdin; returns 1 when the file was already identical
  tmp="$1.tmp.$$"; cat > "$tmp"
  if [ -f "$1" ] && cmp -s "$tmp" "$1"; then rm -f "$tmp"; return 1; fi
  mv "$tmp" "$1"
}

stage_install() {
  asset=$(need_state ASSET detect); version=$(need_version); expected=$(need_sha)
  [ "$(state_get ACTION)" = keep-newer ] && skip "installed $(installed_version) kept; pass --force to downgrade to $version"
  staged="$STAGING_DIR/$asset.verified"
  dest_dir="$VERSIONS_DIR/$version"; dest="$dest_dir/trent"
  note=""
  if [ -f "$staged" ]; then
    [ "$(digest "$staged")" = "$expected" ] || { rm -f "$staged"; fail "staged $asset no longer matches the expected digest; run the download stage again"; }
    if [ -e "$dest_dir" ]; then
      broken="$dest_dir.broken-$(utc_stamp)"
      mv "$dest_dir" "$broken"
      note="previous $dest_dir moved to $broken; "
    fi
    mkdir -p "$dest_dir"
    mv "$staged" "$dest"
    chmod 755 "$dest"
    reported=$("$dest" --version 2>&1) || { mv "$dest_dir" "$dest_dir.broken-$(utc_stamp)"; fail "installed binary failed to run ($dest --version): $reported"; }
    [ "$reported" = "$version" ] || { mv "$dest_dir" "$dest_dir.broken-$(utc_stamp)"; fail "installed binary reports version '$reported', expected '$version'; moved aside"; }
    fresh=1
  elif [ -f "$dest" ]; then
    [ "$(digest "$dest")" = "$expected" ] || fail "$dest does not match the release digest; re-run without --stage"
    fresh=0
  else
    fail "nothing to install: run the download and verify stages first"
  fi
  # A launcher we control, not a symlink. It execs whichever version ~/.trent/current names, so
  # `trent update` switches versions by rewriting that one file (see LAYOUT.md). The launcher's
  # text never changes between versions; only `current` does, and that write is atomic (tmp + mv).
  changed=0
  write_if_changed "$BIN_DIR/trent" <<EOF && changed=1
#!/bin/sh
# Trent Fleet launcher, written by install.sh. Runs the version named in $CURRENT_FILE.
TRENT_HOME="$TRENT_HOME"
v=\$(head -n 1 "\$TRENT_HOME/current" 2>/dev/null)
[ -n "\$v" ] && [ -x "\$TRENT_HOME/versions/\$v/trent" ] || {
  echo "trent: no installed version recorded in \$TRENT_HOME/current; re-run the installer" >&2; exit 127; }
exec "\$TRENT_HOME/versions/\$v/trent" "\$@"
EOF
  chmod 755 "$BIN_DIR/trent"
  chmod 755 "$BIN_DIR" "$VERSIONS_DIR" "$dest_dir"
  printf '%s\n' "$version" | write_if_changed "$CURRENT_FILE" && changed=1
  if [ "$changed" = 0 ] && [ "$fresh" = 0 ]; then skip "${note}trent $version already installed at $BIN_DIR/trent"; fi
  say "       ${C_MIST}${note}$BIN_DIR/trent -> $dest${C_OFF}"
}

rc_file_for_shell() {
  case "$(basename "${SHELL:-sh}")" in
    zsh)  echo "$HOME/.zshrc" ;;
    bash) echo "$HOME/.bashrc" ;;
    fish) echo "$HOME/.config/fish/config.fish" ;;
    *)    echo "$HOME/.profile" ;;
  esac
}

stage_path() {
  if [ "$TRENT_HOME" = "$HOME/.trent" ]; then bin_expr='$HOME/.trent/bin'; else bin_expr="$BIN_DIR"; fi
  rc=$(rc_file_for_shell)
  case "$rc" in
    *config.fish) line="fish_add_path $bin_expr" ;;
    *)            line="export PATH=\"$bin_expr:\$PATH\"" ;;
  esac
  say "       ${C_MIST}PATH line: ${C_BONE}$line${C_OFF}"
  case ":$PATH:" in *":$BIN_DIR:"*) on_path=1 ;; *) on_path=0 ;; esac
  if [ -f "$rc" ] && grep -qF "$bin_expr" "$rc"; then
    soft "$rc already puts $bin_expr on PATH"
  fi
  if [ "${TRENT_NO_MODIFY_PATH:-0}" = 1 ]; then
    skip "TRENT_NO_MODIFY_PATH=1: add this line to $rc yourself: $line"
  fi
  mkdir -p "$(dirname "$rc")"
  ( umask 022; printf '\n# Trent Fleet\n%s\n' "$line" >> "$rc" )
  if [ "$on_path" = 1 ]; then soft "appended to $rc (already on PATH in this shell)"; fi
  soft "appended to $rc; open a new terminal or run: $line"
}

stage_setup() {
  if [ "${1:-}" = --describe-input ]; then
    echo "trent setup needs a provider API key typed at a terminal; run: $BIN_DIR/trent setup"; return 0
  fi
  [ -x "$BIN_DIR/trent" ] || fail "$BIN_DIR/trent is not installed; run the install stage first"
  if ! interactive; then
    skip "trent setup needs a provider API key typed at a terminal; run: $BIN_DIR/trent setup"
  fi
  say ""
  if [ -t 0 ]; then "$BIN_DIR/trent" setup >&2; else "$BIN_DIR/trent" setup < /dev/tty >&2; fi \
    || soft "trent setup exited $?; run $BIN_DIR/trent setup again when ready"
  say ""
}

stage_doctor() {
  [ -x "$BIN_DIR/trent" ] || fail "$BIN_DIR/trent is not installed; run the install stage first"
  v=$("$BIN_DIR/trent" --version 2>&1) || fail "$BIN_DIR/trent --version failed: $v"
  say ""
  set +e
  "$BIN_DIR/trent" doctor --no-color > "$RUN_TMP/doctor.out" 2>&1; rc=$?
  set -e
  while IFS= read -r line; do say "       $line"; done < "$RUN_TMP/doctor.out"
  say ""
  [ "$rc" = 0 ] && return 0
  summary=$(grep -E 'failed' "$RUN_TMP/doctor.out" | tail -n 1 | sed 's/^[[:space:]]*//')
  soft "trent $v runs; trent doctor exited $rc: ${summary:-see output}. Fix the listed checks, then run $BIN_DIR/trent doctor"
}

# -------------------------------------------------------------------------------- main
usage() {
  cat <<EOF
Trent Fleet installer

  install.sh [--json] [--stage <name>] [--version <x.y.z>] [--force] [--non-interactive]
             [--allow-root] [--insecure-base-url <url>]
  install.sh --manifest

Stages: $STAGE_NAMES
EOF
}

success_box() {
  v=""; if [ -f "$CURRENT_FILE" ]; then v=$(head -n 1 "$CURRENT_FILE"); fi
  say ""
  say "${C_PULSE}  +------------------------------------------------------------------+${C_OFF}"
  say "${C_PULSE}  |${C_OFF}  ${C_BONE}Trent $v is installed.${C_OFF}"
  say "${C_PULSE}  |${C_OFF}"
  say "${C_PULSE}  |${C_OFF}  ${C_MIST}binary   ${C_BONE}$BIN_DIR/trent${C_OFF}"
  say "${C_PULSE}  |${C_OFF}  ${C_MIST}data     ${C_BONE}$TRENT_HOME${C_OFF}"
  say "${C_PULSE}  |${C_OFF}"
  say "${C_PULSE}  |${C_OFF}  ${C_MIST}Next, in a new terminal:${C_OFF}"
  if [ ! -f "$TRENT_HOME/config.yaml" ]; then
  say "${C_PULSE}  |${C_OFF}    ${C_BONE}trent setup${C_OFF}            ${C_MIST}add a provider key and pick a model${C_OFF}"
  fi
  say "${C_PULSE}  |${C_OFF}    ${C_BONE}trent${C_OFF}                  ${C_MIST}talk to the fleet${C_OFF}"
  say "${C_PULSE}  |${C_OFF}    ${C_BONE}trent desktop install${C_OFF}  ${C_MIST}add the desktop app${C_OFF}"
  say "${C_PULSE}  +------------------------------------------------------------------+${C_OFF}"
  say ""
}

main() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --manifest) printf '%s\n' "$MANIFEST_JSON"; exit 0 ;;
      --json) JSON=1 ;;
      --stage) [ $# -ge 2 ] || { echo "--stage needs a name" >&2; exit 2; }; ONLY_STAGE="$2"; shift ;;
      --version) [ $# -ge 2 ] || { echo "--version needs a value" >&2; exit 2; }; REQUESTED_VERSION="$2"; shift ;;
      --force) FORCE=1 ;;
      --non-interactive) NONINTERACTIVE=1 ;;
      --allow-root) ALLOW_ROOT=1 ;;
      --insecure-base-url)
        [ $# -ge 2 ] || { echo "--insecure-base-url needs a URL" >&2; exit 2; }
        case "$2" in http://*|https://*) ;; *) echo "--insecure-base-url must be an http(s) URL" >&2; exit 2 ;; esac
        RELEASE_BASE="${2%/}"; RELEASE_LATEST="${RELEASE_BASE%/download}/latest"
        ALLOWED_HOSTS="$(url_host "$RELEASE_BASE")"; CURL_PROTO="=http,https"; INSECURE_BASE=1; shift ;;
      -h|--help) usage; exit 0 ;;
      *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
    esac
    shift
  done
  detect_colour
  if [ -n "$ONLY_STAGE" ]; then
    case " $STAGE_NAMES " in *" $ONLY_STAGE "*) ;; *) echo "unknown stage '$ONLY_STAGE' (known: $STAGE_NAMES)" >&2; exit 2 ;; esac
  fi
  if [ "$INSECURE_BASE" = 1 ]; then
    say "  WARNING: --insecure-base-url is set. Artefacts come from $RELEASE_BASE, not GitHub Releases,"
    say "  and plain http is allowed. Signature and digest checks still apply. Never use this for a real install."
  fi
  interactive || NONINTERACTIVE=1
  if [ -n "$ONLY_STAGE" ]; then
    run_stage "$ONLY_STAGE"
  else
    for s in $STAGE_NAMES; do run_stage "$s"; done
  fi
  if [ -n "$FAILED_STAGE" ]; then
    say ""
    say "${C_BONE}Install did not complete: stage $FAILED_STAGE failed.${C_OFF} ${C_MIST}Fix the cause and re-run the same command; finished stages are skipped.${C_OFF}"
    exit 1
  fi
  [ -z "$ONLY_STAGE" ] && success_box
  return 0
}

# TRENT_INSTALLER_LIBRARY=1 lets the tests source this file and drive run_stage directly.
if [ "${TRENT_INSTALLER_LIBRARY:-0}" != 1 ]; then
  main "$@"
fi
