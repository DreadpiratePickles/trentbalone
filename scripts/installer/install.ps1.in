# Trent Fleet installer (Windows PowerShell 5.1+ / PowerShell 7). GENERATED from
# scripts/installer/install.ps1.in by scripts/installer/render.sh — edit the template, not this file.
#
#   irm https://agent.let-trent.uk/install.ps1 | iex
#
# Same stages, same --json frames and same security rules as install.sh (see that file's header
# and scripts/installer/THREAT-MODEL.md). Both scripts are rendered from one stage manifest and
# scripts/install.test.sh asserts their -Manifest outputs are identical.
#
#   install.ps1 [-Json] [-Stage <name>] [-Version <x.y.z>] [-Force] [-NonInteractive]
#               [-AllowAdmin] [-InsecureBaseUrl <url>]
#   install.ps1 -Manifest
#
# Signature verification on Windows uses the ECDSA P-256 co-signature (SHA256SUMS.sig) through
# CNG, because .NET has no built-in Ed25519. The minisign signature is the canonical one and is
# what `trent update` verifies once installed.
#
# STATUS: this script has not yet been executed on Windows in this repo's CI (milestone 5.4).
[CmdletBinding()]
param(
  [switch]$Json,
  [string]$Stage = "",
  [string]$Version = $env:TRENT_VERSION,
  [switch]$Force,
  [switch]$NonInteractive,
  [switch]$AllowAdmin,
  [string]$InsecureBaseUrl = "",
  [switch]$Manifest
)
Set-StrictMode -Version Latest
$ErrorActionPreference = "Stop"
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 -bor [Net.SecurityProtocolType]::Tls13

@@STAGES@@

if ($Manifest) { Write-Output $ManifestJson; exit 0 }

$TrentRepo = "DreadpiratePickles/trentbalone"
$ReleaseBase = "https://github.com/$TrentRepo/releases/download"
$ReleaseLatest = "https://github.com/$TrentRepo/releases/latest"
$AllowedHosts = @("github.com", "objects.githubusercontent.com", "release-assets.githubusercontent.com")
$InsecureBase = $false
if ($InsecureBaseUrl -ne "") {
  if ($InsecureBaseUrl -notmatch '^https?://') { Write-Error "-InsecureBaseUrl must be an http(s) URL"; exit 2 }
  $ReleaseBase = $InsecureBaseUrl.TrimEnd("/")
  $ReleaseLatest = ($ReleaseBase -replace '/download$', '') + "/latest"
  $AllowedHosts = @(([Uri]$ReleaseBase).Authority)
  $InsecureBase = $true
}

$TrentHome = if ($env:TRENT_HOME) { $env:TRENT_HOME } else { Join-Path $HOME ".trent" }
if (-not $TrentHome.StartsWith($HOME, [StringComparison]::OrdinalIgnoreCase)) { Write-Error "TRENT_HOME=$TrentHome is outside HOME=$HOME; the installer never writes outside your profile"; exit 2 }
$BinDir = Join-Path $TrentHome "bin"
$VersionsDir = Join-Path $TrentHome "versions"
$StagingDir = Join-Path $TrentHome "staging"
$StateFile = Join-Path $TrentHome "installer\state"
$CurrentFile = Join-Path $TrentHome "current"
$Asset = "trent-windows-x64.exe"
$VersionRe = '^[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z.]+)?$'
$script:FailedStage = ""
$script:RunTmp = $null

# ------------------------------------------------------------------- release public keys
$MinisignPub = '@@MINISIGN_PUB@@'
# ECDSA P-256 public point X||Y (64 bytes hex), rendered from keys/ecdsa-p256.pub.pem.
$EcdsaXY = '@@ECDSA_XY@@'

# ------------------------------------------------------------------------------- banner
$BannerTruecolor = @'
@@BANNER_TRUECOLOR@@
'@
$Banner16 = @'
@@BANNER_16@@
'@

# ------------------------------------------------------------------------------ output
$Esc = [char]27
$script:ColourMode = "none"
$C = @{ Bone = ""; Mist = ""; Pulse = ""; Off = "" }
function Detect-Colour {
  if ($env:NO_COLOR -or -not $Host.UI.SupportsVirtualTerminal) { $script:ColourMode = "none"; return }
  if ($env:COLORTERM -match '^(truecolor|24bit)$') { $script:ColourMode = "truecolor" }
  elseif ($env:TERM -match '-256color$') { $script:ColourMode = "256" }
  else { $script:ColourMode = "16" }
  if ($script:ColourMode -eq "truecolor") {
    $C.Bone = "$Esc[38;2;241;236;226m"; $C.Mist = "$Esc[38;2;148;163;184m"; $C.Pulse = "$Esc[38;2;110;231;183m"
  } else { $C.Bone = "$Esc[97m"; $C.Mist = "$Esc[37m"; $C.Pulse = "$Esc[92m" }
  $C.Off = "$Esc[0m"
}
function Say([string]$Text) { if ($Json) { [Console]::Error.WriteLine($Text) } else { Write-Host $Text } }
function Print-Banner {
  Say ""
  switch ($script:ColourMode) {
    "truecolor" { if ($BannerTruecolor.Trim()) { Say $BannerTruecolor } else { Say "$($C.Bone)  TRENT FLEET$($C.Off)" } }
    "none"      { Say "  TRENT FLEET" }
    default     { if ($Banner16.Trim()) { Say $Banner16 } else { Say "$($C.Bone)  TRENT FLEET$($C.Off)" } }
  }
  Say "$($C.Mist)  the AI cofounder, installed under $TrentHome$($C.Off)"
  Say ""
}
function Json-Escape([string]$s) { ($s -replace '\\', '\\' -replace '"', '\"' -replace "`t", '\t' -replace "`r", '' -replace "`n", '\n') }

function Emit-Frame([bool]$Ok, [string]$Name, [bool]$Skipped, [string]$Reason, [int]$Duration) {
  if ($Json) {
    $okS = if ($Ok) { "true" } else { "false" }; $skS = if ($Skipped) { "true" } else { "false" }
    $line = "{`"ok`":$okS,`"stage`":`"$Name`",`"skipped`":$skS"
    if ($Reason) { $line += ",`"reason`":`"$(Json-Escape $Reason)`"" }
    $line += ",`"duration_ms`":$Duration}"
    Write-Output $line
  } else {
    $title = $StageTitles[$Name]
    if ($Ok -and -not $Skipped -and -not $Reason) { Say "  $($C.Pulse)ok  $($C.Off) $($C.Bone)$title$($C.Off) $($C.Mist)${Duration}ms$($C.Off)" }
    elseif ($Ok -and -not $Skipped) { Say "  $($C.Pulse)ok  $($C.Off) $($C.Bone)$title$($C.Off) $($C.Mist)$Reason$($C.Off)" }
    elseif ($Ok) { Say "  $($C.Mist)skip$($C.Off) $($C.Bone)$title$($C.Off) $($C.Mist)$Reason$($C.Off)" }
    else { Say "  $($C.Bone)FAIL$($C.Off) $($C.Bone)$title$($C.Off)"; foreach ($l in ($Reason -split "`n")) { Say "       $($C.Mist)$l$($C.Off)" } }
  }
}

# --------------------------------------------------------------------------- stage runner
# Outcome channel: a stage throws a StageOutcome with Kind = ok | skip | soft | fail.
class StageOutcome : System.Exception {
  [string]$Kind; [string]$Reason
  StageOutcome([string]$k, [string]$r) : base($r) { $this.Kind = $k; $this.Reason = $r }
}
function Skip([string]$r) { throw [StageOutcome]::new("skip", $r) }
function Soft([string]$r) { throw [StageOutcome]::new("soft", $r) }
function Fail([string]$r) { throw [StageOutcome]::new("fail", $r) }

function Is-Admin {
  $id = [Security.Principal.WindowsIdentity]::GetCurrent()
  return (New-Object Security.Principal.WindowsPrincipal $id).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}
function Init-Run {
  if ($script:RunTmp) { return }
  foreach ($d in @($TrentHome, $BinDir, $VersionsDir, $StagingDir, (Join-Path $TrentHome "installer"))) { New-Item -ItemType Directory -Force -Path $d | Out-Null }
  $script:RunTmp = Join-Path $StagingDir ("run." + [IO.Path]::GetRandomFileName())
  New-Item -ItemType Directory -Path $script:RunTmp | Out-Null
  # Private to this user: strip inherited ACEs and grant only the current user.
  $acl = Get-Acl $script:RunTmp
  $acl.SetAccessRuleProtection($true, $false)
  $me = [Security.Principal.WindowsIdentity]::GetCurrent().User
  $acl.AddAccessRule((New-Object Security.AccessControl.FileSystemAccessRule($me, "FullControl", "ContainerInherit,ObjectInherit", "None", "Allow")))
  Set-Acl $script:RunTmp $acl
}
function Run-Stage([string]$Name) {
  Init-Run
  $sw = [Diagnostics.Stopwatch]::StartNew()
  if ($script:FailedStage) { Emit-Frame $true $Name $true "not run: stage $($script:FailedStage) failed" 0; return }
  if ((Is-Admin) -and -not $AllowAdmin) {
    Emit-Frame $false $Name $false "refusing to run elevated: trent installs under your profile without administrator rights. Re-run from a normal PowerShell, or pass -AllowAdmin if this really is intended" 0
    $script:FailedStage = $Name; return
  }
  if ($NonInteractive -and $StageNeedsInput[$Name]) {
    Emit-Frame $true $Name $true "trent setup needs a provider API key typed at a terminal; run: $BinDir\trent.cmd setup" 0; return
  }
  # The try/catch is the guarantee: whatever the stage body throws, a frame is written.
  try {
    & "Stage-$Name"
    Emit-Frame $true $Name $false "" $sw.ElapsedMilliseconds
  } catch [StageOutcome] {
    $o = $_.Exception
    switch ($o.Kind) {
      "skip" { Emit-Frame $true $Name $true $o.Reason $sw.ElapsedMilliseconds }
      "soft" { Emit-Frame $true $Name $false $o.Reason $sw.ElapsedMilliseconds }
      default { Emit-Frame $false $Name $false $o.Reason $sw.ElapsedMilliseconds; $script:FailedStage = $Name }
    }
  } catch {
    Emit-Frame $false $Name $false ("stage $Name failed: " + $_.Exception.Message) $sw.ElapsedMilliseconds
    $script:FailedStage = $Name
  }
}

# ------------------------------------------------------------------------------- state
function State-Get([string]$Key) {
  if (-not (Test-Path $StateFile)) { return "" }
  foreach ($l in Get-Content $StateFile) { if ($l.StartsWith("$Key=")) { return $l.Substring($Key.Length + 1) } }
  return ""
}
function State-Set([string]$Key, [string]$Value) {
  $lines = @(); if (Test-Path $StateFile) { $lines = @(Get-Content $StateFile | Where-Object { -not $_.StartsWith("$Key=") }) }
  $lines += "$Key=$Value"
  Set-Content -Path $StateFile -Value ($lines | Sort-Object) -Encoding ascii
}
function Need-State([string]$Key, [string]$StageName) { $v = State-Get $Key; if (-not $v) { Fail "no $Key recorded; run the $StageName stage first (install.ps1 -Stage $StageName)" }; return $v }
function Need-Version { $v = Need-State "VERSION" "resolve-version"; if ($v -notmatch $VersionRe) { Fail "recorded version '$v' is not a valid version string" }; return $v }
function Installed-Version { if (Test-Path $CurrentFile) { $v = Get-Content $CurrentFile -First 1; if ($v -match $VersionRe) { return $v } }; return "" }
function Need-Sha { $v = Need-State "EXPECTED_SHA" "resolve-version"; if ($v -notmatch '^[0-9a-f]{64}$') { Fail "recorded digest is malformed" }; return $v }
function Digest([string]$Path) { (Get-FileHash -Algorithm SHA256 -Path $Path).Hash.ToLower() }
function Version-Lt([string]$a, [string]$b) {
  $x = ($a -split '-')[0] -split '\.' | ForEach-Object { [int]$_ }; $y = ($b -split '-')[0] -split '\.' | ForEach-Object { [int]$_ }
  for ($i = 0; $i -lt [Math]::Max($x.Count, $y.Count); $i++) {
    $p = if ($i -lt $x.Count) { $x[$i] } else { 0 }; $q = if ($i -lt $y.Count) { $y[$i] } else { 0 }
    if ($p -lt $q) { return $true }; if ($p -gt $q) { return $false }
  }
  return $false
}
function Interactive { -not $NonInteractive -and -not $env:CI -and -not [Console]::IsInputRedirected }

# Fetch: TLS 1.2+, https only unless -InsecureBaseUrl, redirects must stay on a release host,
# byte count must match Content-Length.
function Fetch([string]$Url, [string]$Out) {
  if ($Url -notmatch '^https://' -and -not ($InsecureBase -and $Url -match '^http://')) { Fail "refusing non-https URL $Url" }
  $client = [Net.Http.HttpClientHandler]::new(); $client.AllowAutoRedirect = $true; $client.MaxAutomaticRedirections = 5
  $http = [Net.Http.HttpClient]::new($client); $http.Timeout = [TimeSpan]::FromMinutes(10)
  try {
    $resp = $http.GetAsync($Url, [Net.Http.HttpCompletionOption]::ResponseHeadersRead).GetAwaiter().GetResult()
    if (-not $resp.IsSuccessStatusCode) { Fail "download failed: $Url ($([int]$resp.StatusCode) $($resp.ReasonPhrase))" }
    $effective = $resp.RequestMessage.RequestUri
    if ($AllowedHosts -notcontains $effective.Authority) { Fail "refused: $Url redirected to $effective, whose host '$($effective.Authority)' is not a release host ($($AllowedHosts -join ' '))" }
    if ($effective.Scheme -ne "https" -and -not $InsecureBase) { Fail "refused: redirect to non-https $effective" }
    $declared = $resp.Content.Headers.ContentLength
    $fs = [IO.File]::Create($Out)
    try { $resp.Content.CopyToAsync($fs).GetAwaiter().GetResult() } finally { $fs.Dispose() }
    $size = (Get-Item $Out).Length
    if ($null -ne $declared -and $declared -ne $size) { Remove-Item -Force $Out; Fail "truncated download: $Url declared $declared bytes, received $size" }
    if ($size -eq 0) { Remove-Item -Force $Out; Fail "download of $Url produced an empty file" }
  } catch [StageOutcome] { throw } catch {
    if (Test-Path $Out) { Remove-Item -Force $Out }
    Fail "download failed: $Url`n$($_.Exception.Message)"
  } finally { $http.Dispose() }
}

# --------------------------------------------------------------------- signature check
# ECDSA P-256 / SHA-256 over SHA256SUMS. openssl emits a DER SEQUENCE{r,s}; CNG wants r||s.
function Der-To-P1363([byte[]]$der) {
  if ($der[0] -ne 0x30) { Fail "SHA256SUMS.sig is not a DER ECDSA signature" }
  $i = 2; if ($der[1] -band 0x80) { $i = 2 + ($der[1] -band 0x7f) }
  $out = New-Object byte[] 64
  foreach ($k in 0, 1) {
    if ($der[$i] -ne 0x02) { Fail "SHA256SUMS.sig is malformed" }
    $len = $der[$i + 1]; $start = $i + 2
    $int = $der[$start..($start + $len - 1)]
    while ($int.Count -gt 32 -and $int[0] -eq 0) { $int = $int[1..($int.Count - 1)] }
    if ($int.Count -gt 32) { Fail "SHA256SUMS.sig is malformed (integer too long)" }
    [Array]::Copy($int, 0, $out, ($k * 32) + (32 - $int.Count), $int.Count)
    $i = $start + $len
  }
  return $out
}
function Verify-SumsSignature([string]$Sums, [string]$Sig) {
  if (-not (Test-Path $Sig)) { Fail "release publishes no SHA256SUMS.sig (ECDSA co-signature); refusing unsigned artefacts. (Windows verifies the ECDSA co-signature; .NET has no Ed25519 for SHA256SUMS.minisig.)" }
  $xy = [byte[]]::new(64); for ($i = 0; $i -lt 64; $i++) { $xy[$i] = [Convert]::ToByte($EcdsaXY.Substring($i * 2, 2), 16) }
  # BCRYPT_ECCKEY_BLOB: magic ECS1 (0x31534345) + cbKey 32 + X + Y
  $blob = [byte[]](0x45, 0x43, 0x53, 0x31, 0x20, 0, 0, 0) + $xy
  $key = [Security.Cryptography.CngKey]::Import($blob, [Security.Cryptography.CngKeyBlobFormat]::EccPublicBlob)
  $ecdsa = [Security.Cryptography.ECDsaCng]::new($key); $ecdsa.HashAlgorithm = [Security.Cryptography.CngAlgorithm]::Sha256
  $sig = Der-To-P1363 ([IO.File]::ReadAllBytes($Sig))
  if (-not $ecdsa.VerifyData([IO.File]::ReadAllBytes($Sums), $sig)) {
    Fail "SHA256SUMS.sig does NOT verify against the embedded Trent release key (ECDSA P-256).`nThe checksum file is not from the Trent release key. Nothing was installed."
  }
  return "CNG (ECDSA P-256 co-signature)"
}

# ------------------------------------------------------------------------------ stages
function Stage-detect {
  Print-Banner
  if (-not [Environment]::Is64BitOperatingSystem) { Fail "only 64-bit Windows is supported" }
  $arch = $env:PROCESSOR_ARCHITECTURE
  if ($arch -ne "AMD64") { Fail "unsupported CPU architecture: $arch (supported: AMD64; no windows-arm64 build is published yet)" }
  State-Set "OS" "windows"; State-Set "ARCH" "x64"; State-Set "ASSET" $Asset
  Say "       $($C.Mist)windows/x64, asset $Asset, colour $($script:ColourMode)$($C.Off)"
}

function Stage-resolve-version {
  $asset = Need-State "ASSET" "detect"
  if ($Version) { $v = $Version.TrimStart("v") }
  else {
    $h = [Net.Http.HttpClientHandler]::new(); $h.AllowAutoRedirect = $false
    $http = [Net.Http.HttpClient]::new($h)
    try {
      $resp = $http.SendAsync([Net.Http.HttpRequestMessage]::new([Net.Http.HttpMethod]::Head, $ReleaseLatest)).GetAwaiter().GetResult()
      $loc = "$($resp.Headers.Location)"
    } catch { Fail "could not resolve the latest release from ${ReleaseLatest}: $($_.Exception.Message)" } finally { $http.Dispose() }
    if (-not $loc) { Fail "could not resolve the latest release from $ReleaseLatest (no redirect)" }
    $lu = [Uri]$loc
    if ($AllowedHosts -notcontains $lu.Authority) { Fail "refused: $ReleaseLatest redirected to '$loc', whose host is not a release host" }
    if ($loc -notmatch '/releases/tag/v(.+)$') { Fail "unexpected redirect from ${ReleaseLatest}: '$loc' (expected .../releases/tag/v<version>)" }
    $v = $Matches[1]
  }
  if ($v -notmatch $VersionRe) { Fail "refused: version '$v' does not match $VersionRe" }
  State-Set "VERSION" $v
  $installed = Installed-Version
  if ($installed -and -not $Force -and (Version-Lt $v $installed)) {
    State-Set "ACTION" "keep-newer"
    Soft "installed $installed is newer than requested $v; keeping it (pass -Force to downgrade)"
  }
  State-Set "ACTION" "install"
  $base = "$ReleaseBase/v$v"
  $sums = Join-Path $script:RunTmp "SHA256SUMS"; $sig = Join-Path $script:RunTmp "SHA256SUMS.sig"
  Fetch "$base/SHA256SUMS" $sums
  try { Fetch "$base/SHA256SUMS.sig" $sig } catch [StageOutcome] { if (Test-Path $sig) { Remove-Item -Force $sig } }
  $method = Verify-SumsSignature $sums $sig
  $expected = ""
  foreach ($l in Get-Content $sums) { if ($l -match "^([0-9a-f]{64}) [ *]$([regex]::Escape($asset))$") { $expected = $Matches[1]; break } }
  if (-not $expected) { Fail "release v$v has no SHA256SUMS entry for $asset" }
  State-Set "EXPECTED_SHA" $expected
  Say "       $($C.Mist)trent $v; SHA256SUMS signature verified via $method; expected sha256 $expected$($C.Off)"
}

function Stage-download {
  $asset = Need-State "ASSET" "detect"; $v = Need-Version; $expected = Need-Sha
  if ((State-Get "ACTION") -eq "keep-newer") { Skip "installed $(Installed-Version) is newer than $v; pass -Force to downgrade" }
  $target = Join-Path $VersionsDir "$v\trent.exe"
  if ((Test-Path $target) -and (Digest $target) -eq $expected) { Skip "trent $v is already installed with a matching digest" }
  $url = "$ReleaseBase/v$v/$asset"
  Remove-Item -Force -ErrorAction SilentlyContinue (Join-Path $StagingDir "$asset.unverified"), (Join-Path $StagingDir "$asset.verified")
  $tmp = Join-Path $script:RunTmp $asset
  Fetch $url $tmp
  Move-Item -Force $tmp (Join-Path $StagingDir "$asset.unverified")
  Say "       $($C.Mist)$((Get-Item (Join-Path $StagingDir "$asset.unverified")).Length) bytes from $url$($C.Off)"
}

function Stage-verify {
  $asset = Need-State "ASSET" "detect"; $v = Need-Version; $expected = Need-Sha
  if ((State-Get "ACTION") -eq "keep-newer") { Skip "nothing downloaded; installed version kept" }
  $staged = Join-Path $StagingDir "$asset.unverified"; $verified = Join-Path $StagingDir "$asset.verified"
  $installed = Join-Path $VersionsDir "$v\trent.exe"
  if (Test-Path $staged) {
    $actual = Digest $staged
    if ($actual -ne $expected) {
      Remove-Item -Force $staged
      Fail "SHA-256 mismatch for $asset (v$v); the download was discarded and nothing was installed`n  expected $expected`n  actual   $actual`nThe artefact does not match the signed SHA256SUMS. Retry later; if it persists, the release or the network path is compromised."
    }
    Move-Item -Force $staged $verified
    Say "       $($C.Mist)sha256 $actual matches the signed SHA256SUMS$($C.Off)"
  } elseif (Test-Path $verified) {
    if ((Digest $verified) -ne $expected) { Remove-Item -Force $verified; Fail "previously verified file no longer matches; re-run the download stage" }
    Soft "re-verified the staged $asset"
  } elseif (Test-Path $installed) {
    $actual = Digest $installed
    if ($actual -ne $expected) { Fail "installed $installed has sha256 $actual, expected $expected; re-run without -Stage to reinstall" }
    Soft "installed trent $v re-verified against the signed SHA256SUMS"
  } else { Fail "nothing to verify: no download in $StagingDir and no installed trent $v" }
}

function Write-IfChanged([string]$Path, [string]$Content) {
  if ((Test-Path $Path) -and ((Get-Content -Raw $Path) -eq $Content)) { return $false }
  Set-Content -Path $Path -Value $Content -NoNewline -Encoding ascii; return $true
}

function Stage-install {
  $asset = Need-State "ASSET" "detect"; $v = Need-Version; $expected = Need-Sha
  if ((State-Get "ACTION") -eq "keep-newer") { Skip "installed $(Installed-Version) kept; pass -Force to downgrade to $v" }
  $staged = Join-Path $StagingDir "$asset.verified"
  $destDir = Join-Path $VersionsDir $v; $dest = Join-Path $destDir "trent.exe"
  $note = ""; $fresh = $false
  if (Test-Path $staged) {
    if ((Digest $staged) -ne $expected) { Remove-Item -Force $staged; Fail "staged $asset no longer matches the expected digest; run the download stage again" }
    if (Test-Path $destDir) { $broken = "$destDir.broken-$((Get-Date).ToUniversalTime().ToString('yyyyMMddTHHmmssZ'))"; Move-Item $destDir $broken; $note = "previous $destDir moved to $broken; " }
    New-Item -ItemType Directory -Force -Path $destDir | Out-Null
    Move-Item -Force $staged $dest
    $reported = (& $dest --version 2>&1 | Out-String).Trim()
    if ($LASTEXITCODE -ne 0) { Move-Item $destDir "$destDir.broken-$((Get-Date).ToUniversalTime().ToString('yyyyMMddTHHmmssZ'))"; Fail "installed binary failed to run ($dest --version): $reported" }
    if ($reported -ne $v) { Move-Item $destDir "$destDir.broken-$((Get-Date).ToUniversalTime().ToString('yyyyMMddTHHmmssZ'))"; Fail "installed binary reports version '$reported', expected '$v'; moved aside" }
    $fresh = $true
  } elseif (Test-Path $dest) {
    if ((Digest $dest) -ne $expected) { Fail "$dest does not match the release digest; re-run without -Stage" }
  } else { Fail "nothing to install: run the download and verify stages first" }
  # Launcher reads the version from ~/.trent/current at run time (see LAYOUT.md).
  $shim = "@echo off`r`nrem Trent Fleet launcher, written by install.ps1. Runs the version named in $CurrentFile.`r`nsetlocal`r`nset /p TRENT_V=<`"$CurrentFile`"`r`n`"$VersionsDir\%TRENT_V%\trent.exe`" %*`r`n"
  $changed = Write-IfChanged (Join-Path $BinDir "trent.cmd") $shim
  # Atomic switch: write current to a temp file and rename it into place.
  $tmpCur = "$CurrentFile.tmp"; Set-Content -Path $tmpCur -Value "$v`n" -NoNewline -Encoding ascii
  if ((Test-Path $CurrentFile) -and ((Get-Content -Raw $CurrentFile) -eq "$v`n")) { Remove-Item $tmpCur } else { Move-Item -Force $tmpCur $CurrentFile; $changed = $true }
  if (-not $changed -and -not $fresh) { Skip "${note}trent $v already installed at $BinDir\trent.cmd" }
  Say "       $($C.Mist)${note}$BinDir\trent.cmd -> $dest$($C.Off)"
}

function Stage-path {
  $line = "`$env:Path = `"$BinDir;`" + `$env:Path"
  Say "       $($C.Mist)PATH line: $($C.Bone)$line$($C.Off)"
  $user = [Environment]::GetEnvironmentVariable("Path", "User")
  $parts = @(); if ($user) { $parts = $user -split ';' | Where-Object { $_ } }
  if ($parts -contains $BinDir) { Soft "user PATH already contains $BinDir" }
  if ($env:TRENT_NO_MODIFY_PATH -eq "1") { Skip "TRENT_NO_MODIFY_PATH=1: add $BinDir to your user PATH yourself" }
  [Environment]::SetEnvironmentVariable("Path", (($parts + $BinDir) -join ';'), "User")
  Soft "added $BinDir to the user PATH; open a new terminal or run: $line"
}

function Stage-setup {
  $shim = Join-Path $BinDir "trent.cmd"
  if (-not (Test-Path $shim)) { Fail "$shim is not installed; run the install stage first" }
  if (-not (Interactive)) { Skip "trent setup needs a provider API key typed at a terminal; run: $shim setup" }
  Say ""
  & $shim setup
  if ($LASTEXITCODE -ne 0) { Soft "trent setup exited $LASTEXITCODE; run $shim setup again when ready" }
  Say ""
}

function Stage-doctor {
  $shim = Join-Path $BinDir "trent.cmd"
  if (-not (Test-Path $shim)) { Fail "$shim is not installed; run the install stage first" }
  $v = (& $shim --version 2>&1 | Out-String).Trim()
  if ($LASTEXITCODE -ne 0) { Fail "$shim --version failed: $v" }
  Say ""
  $out = & $shim doctor --no-color 2>&1 | Out-String
  $rc = $LASTEXITCODE
  foreach ($l in ($out -split "`n")) { Say "       $l" }
  Say ""
  if ($rc -eq 0) { return }
  $summary = ($out -split "`n" | Where-Object { $_ -match 'failed' } | Select-Object -Last 1)
  Soft "trent $v runs; trent doctor exited ${rc}: $($summary.Trim()). Fix the listed checks, then run $shim doctor"
}

# -------------------------------------------------------------------------------- main
function Success-Box {
  $v = if (Test-Path $CurrentFile) { Get-Content $CurrentFile -First 1 } else { "" }
  Say ""
  Say "$($C.Pulse)  +------------------------------------------------------------------+$($C.Off)"
  Say "$($C.Pulse)  |$($C.Off)  $($C.Bone)Trent $v is installed.$($C.Off)"
  Say "$($C.Pulse)  |$($C.Off)"
  Say "$($C.Pulse)  |$($C.Off)  $($C.Mist)binary   $($C.Bone)$BinDir\trent.cmd$($C.Off)"
  Say "$($C.Pulse)  |$($C.Off)  $($C.Mist)data     $($C.Bone)$TrentHome$($C.Off)"
  Say "$($C.Pulse)  |$($C.Off)"
  Say "$($C.Pulse)  |$($C.Off)  $($C.Mist)Next, in a new terminal:$($C.Off)"
  if (-not (Test-Path (Join-Path $TrentHome "config.yaml"))) {
  Say "$($C.Pulse)  |$($C.Off)    $($C.Bone)trent setup$($C.Off)            $($C.Mist)add a provider key and pick a model$($C.Off)"
  }
  Say "$($C.Pulse)  |$($C.Off)    $($C.Bone)trent$($C.Off)                  $($C.Mist)talk to the fleet$($C.Off)"
  Say "$($C.Pulse)  |$($C.Off)    $($C.Bone)trent desktop install$($C.Off)  $($C.Mist)add the desktop app$($C.Off)"
  Say "$($C.Pulse)  +------------------------------------------------------------------+$($C.Off)"
  Say ""
}

Detect-Colour
if ($Stage -and ($StageNames -notcontains $Stage)) { Write-Error "unknown stage '$Stage' (known: $($StageNames -join ' '))"; exit 2 }
if ($InsecureBase) {
  Say "  WARNING: -InsecureBaseUrl is set. Artefacts come from $ReleaseBase, not GitHub Releases,"
  Say "  and plain http is allowed. Signature and digest checks still apply. Never use this for a real install."
}
if (-not (Interactive)) { $NonInteractive = $true }
try {
  if ($Stage) { Run-Stage $Stage } else { foreach ($s in $StageNames) { Run-Stage $s } }
} finally {
  if ($script:RunTmp -and (Test-Path $script:RunTmp)) { Remove-Item -Recurse -Force $script:RunTmp }
}
if ($script:FailedStage) {
  Say ""
  Say "$($C.Bone)Install did not complete: stage $($script:FailedStage) failed.$($C.Off) $($C.Mist)Fix the cause and re-run the same command; finished stages are skipped.$($C.Off)"
  exit 1
}
if (-not $Stage) { Success-Box }
exit 0
