{
  // Mirrors apps/web/tsconfig.json compilerOptions so that files pulled in from
  // apps/web/lib type-check identically here and there. Only `paths` and `include`
  // differ. Do not diverge these settings without changing both.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["../../apps/web/*"],
      "@trent/core/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"]
}
