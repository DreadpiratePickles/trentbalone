{
  "version": 3,
  "profile": "split-fixture",
  "provider": "anthropic",
  "model": "claude-fixture-1",
  "toolsets": ["file_ops", "terminal", "web", "browser", "code", "vision", "memory", "delegation", "cron", "skills", "plugins", "mcp", "human"],
  "disabled_toolsets": ["browser", "vision"],
  "budget": { "daily_cap": 2500, "currency": "EUR", "per_run_cap": 250, "alert_thresholds": [25, 60, 90] },
  "terminal": {
    "backend": "local",
    "docker": { "image": "fixture/sandbox:1", "network": "host" },
    "ssh": { "host": "fixture.internal", "port": 2222, "user": "trent", "key_path": "/keys/id_ed25519" }
  },
  "egress": { "enabled": false, "proxy_port": 9090, "auto_token": false, "intercept_domains": ["api.fixture.test"] },
  "gateway": {
    "enabled": true,
    "platforms": ["slack", "telegram"],
    "routes": { "slack": "ceo", "telegram": "support-responder" },
    "double_text_policy": "interrupt",
    "owner": { "platform": "slack", "channelId": "C0FIXTURE" },
    "alerts": { "approval_wait_minutes": 15 },
    "email": { "require_authenticated_from": false, "authserv_id": "mx.fixture.test" },
    "voice_notes": { "enabled": false, "max_seconds": 120, "max_bytes": 5242880 }
  },
  "repl": { "double_text_policy": "reject", "history_turns": 12, "history_chars": 9000 },
  "context": { "ceiling_chars": 90000, "compact_after_chars": 18000 },
  "runtime": { "max_concurrent_runs": 4 },
  "heartbeat": {
    "enabled": true,
    "interval_minutes": 30,
    "active_hours": { "start": "09:00", "end": "17:00", "tz": "Europe/Berlin" },
    "consolidate_memory": false,
    "sweep": { "enabled": true },
    "sweep_interval_hours": 12
  },
  "fleet": {
    "installed_agents": ["ceo", "eng-ai-engineer", "support-responder"],
    "active_agents": ["ceo", "eng-ai-engineer"],
    "default_agent": "eng-ai-engineer"
  },
  "mcp_servers": {
    "local-tools": {
      "command": "node",
      "args": ["server.js", "--stdio"],
      "env": { "FIXTURE_TOKEN": "${FIXTURE_TOKEN}" },
      "auto_approve": ["ping"],
      "enabled": true,
      "scanRan": true
    },
    "remote-tools": {
      "url": "https://mcp.fixture.test/rpc",
      "headers": { "X-Fixture-Key": "${FIXTURE_KEY}" },
      "enabled": false,
      "scanRan": false,
      "flagged": []
    }
  },
  "telemetry": { "otlp_endpoint": "https://otlp.fixture.test/v1/traces", "service_name": "trent-fixture" },
  "model_overrides": {
    "claude-fixture-1": { "context_window": 200000, "input_cents_per_million": 300, "output_cents_per_million": 1500 }
  },
  "privacy": { "redact_prompts": true, "patterns": ["sk-[A-Za-z0-9]{8,}"] },
  "policy": {
    "rules": [
      { "id": "fixture-deny", "effect": "deny", "when": "external_send", "after": "secret_access", "within": 7, "reason": "fixture rule" },
      { "id": "fixture-approve", "effect": "require_approval", "when": "write", "also": "secret_access", "reason": "fixture approval rule" }
    ]
  },
  "workspace": { "max_file_chars": 5000, "max_total_chars": 9000 },
  "autonomy": "ask_always",
  "approvals": { "deny": ["rm -rf *", "**/.env"] },
  "hooks": {
    "pre_tool_call": [{ "command": ["/usr/bin/true", "--pre"], "timeout_ms": 1000, "match": { "tool": "file_write" } }],
    "post_tool_call": [{ "command": ["/usr/bin/true", "--post"] }],
    "session_start": [],
    "session_stop": [{ "command": ["/usr/bin/true", "--stop"], "timeout_ms": 500 }]
  },
  "memory": {
    "blocks": [
      { "label": "memory", "file": "memory.md", "description": "fixture agent memory", "limit": 4000, "read_only": false },
      { "label": "company", "file": "company.md", "description": "fixture company facts", "limit": 2000, "read_only": true }
    ],
    "embedder": { "provider": "openai", "model": "text-embedding-3-small", "batch_size": 64 },
    "consolidation_may_edit": ["company"],
    "consolidation_max_removal_ratio": 0.5
  },
  "models": { "fast": "fixture-fast", "executor": "fixture-executor", "planner": "fixture-planner", "judge": "fixture-judge", "fallback_on_pin": true, "reasoning_effort": "low" },
  "tools": { "disclosure_threshold": 40 },
  "brain": { "enabled": false, "versioning": "off", "rerank": { "mode": "llm", "model": "gemini-3.5-flash-lite", "max_cents_per_query": 0.5, "min_score": 0.6 } },
  "checkpoints": { "enabled": false, "max_bytes_per_run": 123456 },
  "media": { "backend": "host", "hosted_transcription": true, "whisper_model": "/models/ggml-base.en.bin", "image_provider": "openai", "image_model": "fixture-image-model", "image_price_cents": 5, "image_auto_approve_under_cents": 10 },
  "gate": { "ask_classes": ["deploy"] },
  "retrieval": { "min_recall": 0.75 },
  "cron": { "failure_alert_after": 5, "quota_hold_minutes": 45 },
  "agent": { "auto_recovery_cycles": 2 },
  "connect": { "inherit_default": false },
  "a2a": { "peers": [{ "name": "hermes", "url": "https://hermes.fixture.test/", "token_env": "HERMES_A2A_TOKEN" }, { "name": "local-trent", "url": "http://127.0.0.1:7899" }] },
  "personality": "fixture-personality",
  "theme": "light",
  "improve": {
    "holdout_ratio": 0.4,
    "pass_k": 2,
    "judge_min_tpr": 0.9,
    "judge_min_tnr": 0.7,
    "sweep_cap_cents": 500,
    "frozen_paths": ["docs/frozen.md"],
    "judge_model": "fixture-judge-model",
    "min_goldens": 7
  },
  "an_unknown_future_key": { "kept": true, "by": "passthrough" },
  "gate": { "ask_classes": ["deploy"] }
}
