{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@trent/core": ["../../packages/trent-core/src/index.ts"],
      "@trent/core/*": ["../../packages/trent-core/src/*"],
      "@/*": ["../../apps/web/*"]
    }
  },
  "include": ["src/**/*"]
}
