{
  "name": "trent-ai-cofounder",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --incremental false -p tsconfig.typecheck.json",
    "test": "vitest run --pool=forks --poolOptions.forks.singleFork=true",
    "test:ci": "vitest run --pool=forks --poolOptions.forks.singleFork=true --reporter=default --reporter=json --outputFile=artifacts/ci/vitest-results.json",
    "ci:truth": "tsx scripts/ci/verify-vitest-counts.ts --results artifacts/ci/vitest-results.json --baseline docs/verification/ci-truth-baseline.json --out artifacts/ci/ci-truth.md",
    "runtime:eval": "tsx scripts/evals/run-runtime-acceptance.ts",
    "runtime:eval:smoke": "tsx scripts/evals/run-runtime-acceptance.ts --smoke --threshold 1",
    "workbench:eval:live-cloud": "tsx scripts/evals/run-live-cloud-workbench.ts",
    "workbench:eval:suite": "tsx scripts/evals/run-live-cloud-workbench.ts --suite --integration --threshold 0.8",
    "workbench:eval:smoke": "tsx scripts/evals/run-live-cloud-workbench.ts --suite --smoke --threshold 0.8",
    "providers:proof": "tsx scripts/evals/run-live-provider-proofs.ts",
    "github:import:proof": "tsx scripts/evals/run-live-github-import-proof.ts",
    "mcp:proof": "tsx scripts/evals/run-live-mcp-proof.ts",
    "orc:workbench-proof": "tsx scripts/evals/run-orchestration-workbench-proof.ts",
    "orc:eval": "tsx scripts/evals/run-orchestration-eval.ts --integration --threshold 0.9",
    "orc:eval:smoke": "tsx scripts/evals/run-orchestration-eval.ts --smoke --threshold 0.9",
    "orc:bakeoff": "tsx scripts/evals/run-orchestration-bakeoff.ts",
    "orc:truth-proof": "tsx scripts/evals/run-orchestrator-truth-proof.ts",
    "ops:ui-proof": "tsx scripts/evals/run-ops-ui-proof.ts",
    "workbench:soak": "tsx scripts/evals/run-workbench-soak.ts",
    "agent-plug:eval:e2e": "tsx scripts/evals/run-agent-plug-e2e.ts",
    "test:redis": "vitest run lib/queue.redis.test.ts --pool=forks --poolOptions.forks.singleFork=true",
    "worker": "tsx lib/worker.ts",
    "worker:health": "tsx scripts/worker-health.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "x:refresh:proof": "tsx scripts/evals/run-live-x-refresh-proof.ts",
    "capability:proof": "tsx scripts/evals/run-live-capability-gate-proof.ts",
    "trust-panel:proof": "tsx scripts/evals/run-live-trust-panel-proof.ts",
    "worker:env": "tsx scripts/dev/worker-with-env.ts",
    "acceptance:cycle": "tsx scripts/evals/run-live-acceptance-cycle.ts",
    "briefing:proof": "tsx scripts/evals/run-morning-briefing-proof.ts",
    "compounding:proof": "tsx scripts/evals/run-live-compounding-proof.ts",
    "security:deps": "npm audit --audit-level=high --omit=dev",
    "security:readiness": "tsx scripts/ci/security-readiness-check.ts",
    "preflight:security": "npm run security:deps && npm run security:readiness",
    "preflight:perfection": "npm run typecheck && npm run build && npm run test:ci && npm run ci:truth && npm run preflight:security && npm run orc:truth-proof && npm run orc:workbench-proof -- --env-file ${TRENT_PREFLIGHT_ENV_FILE:-trent.env.local} --provider ${TRENT_PREFLIGHT_WORKBENCH_PROVIDER:-daytona} && npm run workbench:eval:live-cloud -- --provider ${TRENT_PREFLIGHT_WORKBENCH_PROVIDER:-daytona} --env-file ${TRENT_PREFLIGHT_ENV_FILE:-trent.env.local} --runs 1 --threshold 1 && npm run workbench:eval:live-cloud -- --diverse --provider ${TRENT_PREFLIGHT_WORKBENCH_PROVIDER:-daytona} --env-file ${TRENT_PREFLIGHT_ENV_FILE:-trent.env.local} --threshold 1 && npm run providers:proof -- --env-file ${TRENT_PREFLIGHT_ENV_FILE:-trent.env.local} --allow-failures && npm run mcp:proof -- --env-file ${TRENT_PREFLIGHT_ENV_FILE:-trent.env.local} && npm run acceptance:cycle -- --env-file ${TRENT_PREFLIGHT_ENV_FILE:-trent.env.local} && npm run compounding:proof -- --env-file ${TRENT_PREFLIGHT_ENV_FILE:-trent.env.local} && npm run trust-panel:proof -- --env-file ${TRENT_PREFLIGHT_ENV_FILE:-trent.env.local}"
  },
  "dependencies": {
    "@daytona/sdk": "^0.189.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.8.2",
    "@sentry/mcp-server": "^0.36.0",
    "@tanstack/react-query": "^5.77.2",
    "@types/prismjs": "^1.26.6",
    "bs58": "^6.0.0",
    "bullmq": "^5.77.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "e2b": "^2.30.4",
    "ethers": "^6.17.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.511.0",
    "next": "^15.5.19",
    "next-auth": "^5.0.0-beta.28",
    "openai": "^4.103.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.60.0",
    "prisma": "^6.8.2",
    "prismjs": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "svix": "^1.95.2",
    "tsx": "^4.22.4",
    "tweetnacl": "^1.0.3",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.7",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "@grpc/proto-loader": {
      "protobufjs": "7.6.4"
    },
    "@opentelemetry/api-logs": "0.219.0",
    "@opentelemetry/configuration": "0.219.0",
    "@opentelemetry/exporter-logs-otlp-grpc": "0.219.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.219.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.219.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.219.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.219.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.219.0",
    "@opentelemetry/exporter-prometheus": "0.219.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.219.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.219.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.219.0",
    "@opentelemetry/instrumentation-http": "0.219.0",
    "@opentelemetry/otlp-exporter-base": "0.219.0",
    "@opentelemetry/otlp-grpc-exporter-base": "0.219.0",
    "@opentelemetry/otlp-transformer": "0.219.0",
    "@opentelemetry/propagator-b3": "2.8.0",
    "@opentelemetry/propagator-jaeger": "2.8.0",
    "@opentelemetry/resources": "2.8.0",
    "@opentelemetry/sdk-logs": "0.219.0",
    "@opentelemetry/sdk-metrics": "2.8.0",
    "@opentelemetry/sdk-node": "0.219.0",
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "@opentelemetry/sdk-trace-node": "2.8.0",
    "@opentelemetry/exporter-zipkin": "2.8.0",
    "esbuild": "0.28.1",
    "form-data": "4.0.6",
    "protobufjs": "8.6.4",
    "vite": "7.3.5"
  }
}
