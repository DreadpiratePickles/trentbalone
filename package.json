{
  "name": "trent-fleet-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "postinstall": "prisma generate --schema packages/trent-core/prisma/schema.sqlite.prisma --no-hints",
    "test": "vitest run",
    "test:live": "TRENT_TEST_LIVE=1 vitest run",
    "test:web": "npm --prefix apps/web test",
    "test:all": "npm run test && npm run test:web",
    "build": "npm run --workspaces --if-present build",
    "cli": "tsx apps/cli/src/index.ts",
    "cli:bun": "bun --no-env-file apps/cli/src/index.ts",
    "tui": "tsx apps/cli/src/index.ts --tui",
    "doctor": "tsx apps/cli/src/index.ts doctor"
  },
  "devDependencies": {
    "tsx": "^4.22.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "ora": "^9.4.1"
  },
  "license": "MIT"
}
