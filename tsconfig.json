{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@trent/core": ["packages/trent-core/src/index.ts"],
      "@trent/core/*": ["packages/trent-core/src/*"],
      "@/*": ["apps/web/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
